{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "main.py",
      "test_main.py",
      "requirements.txt",
      "Procfile",
      "*.bat",
      "*.sh",
      "*.md",
      "LICENSE"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "polla-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
